{
  "name": "indie-rauljimenez-info-activity",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Renders public posts from this repo as static HTML for posts.rauljimenez.info, and sends outgoing Webmentions for public bookmark/like/reply/rsvp/repost posts.",
  "dependencies": {
    "@hhkaos/webmentions-widget": "^0.5.1",
    "franc-min": "^6.2.0",
    "linkedom": "^0.18.13",
    "markdown-it": "^14.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "microformats-parser": "^2.0.6",
    "playwright": "^1.62.1"
  },
  "scripts": {
    "build": "node scripts/render.mjs",
    "serve": "node scripts/serve.mjs",
    "dev": "HOST=0.0.0.0 node scripts/serve.mjs --watch",
    "verify": "node scripts/verify-mf2.mjs"
  }
}
